# LeadGen LA — Environment Variables
# Copy this file to .env and fill in your API keys

# Google Places API (New) — used for business search, place details, geocoding,
# AND the YouTube Data API v3 (same key — enable YouTube Data API v3 in the console)
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Serper.dev — used for digital ad presence and social media recency detection
# https://serper.dev/api-key
SERPER_API_KEY=your_serper_api_key_here

# Apollo.io Organizations Enrich API — used for owner contact enrichment
# https://developer.apollo.io/
APOLLO_API_KEY=your_apollo_api_key_here

# Server port (optional, defaults to 5000)
PORT=5000
